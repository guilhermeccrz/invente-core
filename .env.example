# Copia para .env só na máquina local. Não commita o .env.
# No Cloud Run os segredos entram pelo Secret Manager, nunca em texto puro.

# api ou worker. A mesma imagem sobe os dois serviços.
ROLE=api
PORT=8080

GOOGLE_CLOUD_PROJECT=project-639ad7da-da3d-4115-970
PUBLIC_API_URL=https://api.invente.ai
PUBLIC_APP_URL=https://invente.ai

# Bucket privado. Todo objeto tem de começar com este prefixo.
MEDIA_BUCKET=inventa-media-project-639ad7da-da3d-4115-970
MEDIA_PREFIX=invente.ai/

# Fila. A URL do worker só existe depois do primeiro deploy.
TASKS_LOCATION=southamerica-east1
TASKS_QUEUE=inventa-jobs
TASKS_WORKER_URL=
TASKS_INVOKER_EMAIL=inventa-api@project-639ad7da-da3d-4115-970.iam.gserviceaccount.com

# Segredo inventa-session-secret. Local: cola o valor. Cloud Run: referência do Secret Manager.
SESSION_SECRET=

# OAuth Web. Só depois de criar o client no console. Domínio: invente.ai.
# Redirect: https://api.invente.ai/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend, fora do GCP. Enquanto a chave estiver vazia, cadastro, reset e aviso de job respondem email_not_configured.
RESEND_API_KEY=
EMAIL_FROM=Invente <nao-responda@invente.ai>

# Pod de GPU. Os dois juntos. Sem os dois, o worker marca o job como pod_not_configured.
POD_BASE_URL=
POD_TOKEN=
POD_NAME=a6000-sp-1

# memory para teste local sem GCP. firestore no Cloud Run.
DATA_BACKEND=memory
